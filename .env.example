# Required: free key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Model. Note that model availability varies by Groq account — run
# `python -m scripts.list_models` to see what your key can actually reach.
AGENT_MODEL=openai/gpt-oss-120b

# Agent behaviour
AGENT_MAX_ITERATIONS=2
AGENT_RESULTS_PER_QUERY=4
AGENT_TEMPERATURE=0.2

# Search engines, tried in order. Free engines rate-limit hard, so the agent
# fails over down this list rather than retrying one that is already limiting us.
AGENT_SEARCH_BACKENDS=duckduckgo,yahoo
AGENT_SEARCH_DELAY=1.0

# Optional: higher-quality search, tried first when set.
# TAVILY_API_KEY=tvly_your_key_here
